# Server configuration
PORT=4000

# Security (Extension matches this key by default)
API_KEY=job-insight-secret-key-2024

# Claude API Configuration
# - Leave CLAUDE_API_KEY empty to run in Offline Heuristic Mode (fast, free, no API key needed).
# - Provide an Anthropic key (sk-ant-...) to enable Claude 3.5 Sonnet deep semantic matching.
CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# MongoDB (Optional: Backend runs in memory-resilient mode if MongoDB is offline)
MONGODB_URI=mongodb://localhost:27017/jobinsight

# Redis (Optional: In-memory cache fallback used if Redis is unavailable)
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
